{
  "name": "@nascencestudio/tapestry-menus",
  "version": "0.1.0",
  "description": "Menus for Tapestry sites on StudioCMS: several menus edited in the dashboard, Menu and Breadcrumbs components, and menu settings in the page editor",
  "license": "MIT",
  "author": "Nascence Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nascencestudio/tapestry-menus.git"
  },
  "homepage": "https://github.com/nascencestudio/tapestry-menus#readme",
  "bugs": {
    "url": "https://github.com/nascencestudio/tapestry-menus/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./menus": {
      "types": "./dist/runtime/menus.d.ts",
      "default": "./dist/runtime/menus.js"
    },
    "./Menu.astro": "./dist/runtime/Menu.astro",
    "./Breadcrumbs.astro": "./dist/runtime/Breadcrumbs.astro",
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@nascencestudio/tapestry": "^0.6.0",
    "astro": "^7.0.0",
    "studiocms": "^0.6.0 || ^0.7.0"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nascencestudio/tapestry": "file:../tapestry",
    "@types/node": "22.20.4",
    "astro": "7.3.5",
    "studiocms": "0.6.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "astro",
    "studiocms",
    "studiocms-plugin",
    "tapestry",
    "menus",
    "navigation",
    "breadcrumbs"
  ],
  "packageManager": "pnpm@12.4.2"
}
